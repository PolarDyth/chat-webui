# Postgres connection — the Supabase transaction pooler URL. Any of the env
# shapes Supabase hands out also work (DATABASE_URL, POSTGRES_URL,
# POSTGRES_PRISMA_URL, or POSTGRES_HOST/USER/PASSWORD/DATABASE) — see
# src/lib/db/connection.ts. Direct (non-pooling) connections are ignored on
# purpose: they exhaust serverless connection limits.
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require"

# OpenRouter. Optional here: you can also store the key in the Settings page,
# which persists it encrypted at rest in your own database (preferred).
# OPENROUTER_API_KEY="sk-or-v1-..."
# OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"

# Required for storing the API key in the database (AES-256-GCM at rest).
# Generate one with: openssl rand -base64 32
SETTINGS_ENCRYPTION_KEY=""

# Reserved for the upcoming Supabase Auth integration:
# NEXT_PUBLIC_SUPABASE_URL="https://<ref>.supabase.co"
# NEXT_PUBLIC_SUPABASE_ANON_KEY=""
